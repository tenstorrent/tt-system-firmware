/* MK BU DMC with both I3C roles in one image: i3c1 controller, i3c2 target. */

/ {
	aliases {
		i3c-target-dev = &i3c2;
	};
};

&i3c1 {
	status = "okay";

	binho_target: binho_target@2a020800000002 {
		compatible = "tenstorrent,smc-remoteproc";
		reg = <0x2a 0x0208 0x00000002>;
		status = "okay";
	};
};

&i3c2 {
	status = "okay";
	target-mode;
	mipi-instance = <0x8>;
};
