mainmenu "ARC HS multichannel DMA test"

source "Kconfig.zephyr"

config DMA_NUM_CHANNELS
	int "Number of ARC HS DMA channels to exercise concurrently"
	default 16

config DMA_MULTIGROUP_BLOCK_COUNT
	int "Chained block count to reach descriptor group 1+ (handle >= 32)"
	default 33

config DMA_BLOCK_SIZE
	int "Transfer block size in bytes"
	default 64

config DMA_BLEN_ALIGNMENT
	int "TX and RX data alignment in bytes"
	default 32
