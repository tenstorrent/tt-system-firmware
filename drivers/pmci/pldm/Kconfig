config PMCI_PLDM_PLATFORM
	bool "Enable PLDM Platform support"
	depends on PLDM && SENSOR_ASYNC_API
	default y
	help
	  Enable PLDM Platform command handling and PDR repository support.

config PMCI_PLDM_OEM
	bool "Enable PLDM OEM support"
	depends on PLDM
	help
	  Enable PLDM OEM support. OEM functionality must be provided by a compatible
	  device implementing the PLDM OEM handler API.

config PMCI_PLDM_BASE
	bool "Enable PLDM Base support"
	depends on PLDM
	help
	  Enable PLDM BASE support

config TT_PMCI_PLDM_SHELL
	bool "Enable PLDM OEM shell bridge"
	depends on SHELL
	depends on PMCI_PLDM_OEM
	select SHELL_BACKEND_DUMMY
	help
	  Enable an OEM PLDM command set that executes shell commands through
	  Zephyr shell APIs and returns captured output over MCTP/PLDM.
	  This is intended for bring-up and debug images.

config TT_PMCI_PLDM_MCTP_RESPONDER
	bool "Tenstorrent PLDM responder over MCTP"
	depends on DT_HAS_TENSTORRENT_PLDM_MCTP_RESPONDER_ENABLED
	depends on MCTP && PLDM && MCTP_I3C_TARGET
	select PMCI_PLDM_BASE
	select PMCI_PLDM_PLATFORM
	help
	  Enable Tenstorrent PLDM responder over an MCTP I3C target transport.
	  The driver consumes PLDM messages and emits responses for supported
	  PLDM Base and Platform commands.

config TT_PMCI_PLDM_LIBPLDM_FD
	bool "Build the libpldm firmware device responder"
	depends on PLDM
	select PLDM_ABI_TESTING
	help
	  Compile libpldm's DSP0267 firmware device responder (pldm_fd_*,
	  src/firmware_device/fd.c) and the PLDM control helper it calls
	  (src/control.c). The libpldm Zephyr module does not build them, and
	  their API is still marked testing (LIBPLDM_ABI_TESTING).

config TT_PMCI_PLDM_FW_UPDATE
	bool "PLDM firmware update (DSP0267) firmware device"
	default y
	depends on DT_HAS_TENSTORRENT_PLDM_FW_UPDATE_ENABLED
	depends on PLDM && MCUBOOT_IMG_MANAGER
	depends on $(dt_nodelabel_enabled,slot1_partition)
	select TT_PMCI_PLDM_LIBPLDM_FD
	select IMG_ERASE_PROGRESSIVELY
	help
	  Answer PLDM for Firmware Update (type 5), with the identity given by
	  the tenstorrent,pldm-fw-update devicetree node. The update agent's
	  image is written to the MCUboot secondary slot, and ActivateFirmware
	  requests a test swap. The new image runs after the next reset and
	  must confirm itself, or MCUboot reverts it. No update is accepted
	  while the running image is unconfirmed.

if TT_PMCI_PLDM_FW_UPDATE

config TT_PMCI_PLDM_FW_UPDATE_TRANSFER_SIZE
	int "Largest firmware data chunk to request"
	default 32
	range 32 1024
	help
	  libpldm never asks for less than 32 bytes. Each chunk arrives in
	  one PLDM message, so the responder must accept messages this size
	  plus 4 bytes of PLDM header and completion code.

endif # TT_PMCI_PLDM_FW_UPDATE
