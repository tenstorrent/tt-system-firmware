config TT_GR_SMC
	bool "Grendel SMC support library"
	select SIVAL_SDK
	help
	  Enable Tenstorrent Grendel SMC support library components.

config TT_GR_SMC_ERR_STR
	bool "Grendel SMC error-string table (Sival SDK err.c)"
	select TT_GR_SMC
	default n
	help
	  Compile grendel_err_to_str from the grendel-sival-sdk tarball's
	  common/src/err.c

config TT_GR_SMC_AVS
	bool "Grendel SMC AVSBus voltage regulator telemetry"
	depends on TT_GR_SMC && TT_TELEMETRY
	default y if SOC_TT_KERAUNOS_SMC
	help
	  Read the core rail voltage, current and temperature from the board
	  voltage regulator over the SMC AVSBus controller and report them in
	  the VCORE, TDC, TDP and VREG_TEMPERATURE telemetry tags. The tags are
	  always present; without this option they read 0.

config TT_GR_SMC_LOG_BRIDGE
	bool "Grendel SMC log bridge"
	depends on LOG
	select TT_GR_SMC
	default n
	help
	  Provide strong log_message/log_with_location overrides for Grendel
	  firmware logging hooks and route them into Zephyr logging.

if TT_GR_SMC_LOG_BRIDGE

module = TT_GR_SMC_LOG_BRIDGE
module-str = Grendel SMC log bridge
source "subsys/logging/Kconfig.template.log_config"

endif # TT_GR_SMC_LOG_BRIDGE
