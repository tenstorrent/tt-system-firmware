config TT_FW_COMMON
	bool "Tenstorrent common firmware library"
	help
	  Portable firmware helpers shared across Tenstorrent SMC products
	  (e.g. Blackhole and Grendel).

if TT_FW_COMMON

config TT_FW_COMMON_EMUL
	bool "fw_common MMIO emulation"
	default y if BOARD_NATIVE_SIM
	help
	  Provide non-inline ReadReg/WriteReg stubs (reg_stub.c) for
	  host/native builds. Selected by TT_BH_ARC_EMUL when Blackhole
	  ARC emulation is enabled.

config TT_MSGQUEUE
	bool "Enable host message queue"
	default y
	select MBOX if DT_HAS_TENSTORRENT_MSGQUEUE_MBOX_ENABLED
	help
	  Enable the portable SMC host message queue implementation.
	  When a tenstorrent,msgqueue-mbox node is present, the mbox
	  IRQ doorbell backend is used instead of Blackhole MSI.

config TT_TELEMETRY
	bool "Telemetry core"
	default y if TT_BH_ARC || TT_GR_SMC
	help
	  Telemetry tag accessors and periodic update, shared across SoCs. Requires a
	  per-SoC implementation of telemetry_platform.h.

config TT_TELEMETRY_PERIODIC
	bool "Periodic telemetry update"
	depends on TT_TELEMETRY
	default y if BH_FWTABLE || TT_GR_SMC

config TT_MSGQUEUE_NUM_MSG_CODES
	int "Number of message codes"
	default 200
	depends on TT_MSGQUEUE
	help
	  Size of the message handler table (message code range).

endif
